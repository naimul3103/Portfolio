# ─── Public build-time values (safe to expose, prefixed PUBLIC_) ──────────────
# Canonical origin. Pages uses this for canonical URLs, OG tags, sitemap, RSS.
PUBLIC_SITE_URL=https://naimul3103.pages.dev
PUBLIC_GITHUB_USERNAME=naimul3103
PUBLIC_GITHUB_URL=https://github.com/naimul3103
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/naimul3103/
PUBLIC_CONTACT_EMAIL=hello@example.com
PUBLIC_TURNSTILE_SITE_KEY=

# ─── Server-side only (Cloudflare Worker env; NEVER prefix PUBLIC_) ──────────
# Set these with `wrangler secret put` — do not commit real values.
# GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# TURNSTILE_SECRET=
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CHAT_ENABLED=true

# ─── CMS (Sveltia) ───────────────────────────────────────────────────────────
# The R2 *secret* access key is never stored here or in the repo; it is entered
# once in the CMS UI and kept in the browser (see docs/secrets.md).
# R2_ACCESS_KEY_ID (non-secret) lives in admin/config.yml.
