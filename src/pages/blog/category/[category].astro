---
import PostCard from '../../../components/blog/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogPage, getSiteConfig } from '../../../lib/config';
import { getPosts, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const page = getBlogPage();
  const posts = await getPosts();
  return Object.entries(page.categories).map(([slug, label]) => ({
    params: { category: slug },
    props: {
      label,
      posts: posts.filter((post) => post.data.category === slug),
    },
  }));
}

interface Props {
  label: string;
  posts: Post[];
}

const { label, posts } = Astro.props as Props;
const site = getSiteConfig();

const page = getBlogPage();
const title = `${label} — ${site.name}`;
const description = `Posts in the ${label} category.`;
---

<BaseLayout title={title} description={description}>
  <section class="page-head">
    <div class="shell">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href="/blog">{page.eyebrow}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{label}</span>
      </nav>
      <h1 class="display">{label}</h1>
      <p class="lede">{posts.length} {posts.length === 1 ? 'post' : 'posts'} in this category.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {posts.length === 0 ? (
        <div class="empty glass">
          <h2>{page.empty.title}</h2>
          <p>{page.empty.body}</p>
        </div>
      ) : (
        <div class="post-list">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )}
      <p class="back"><a class="arrow-link" href="/blog">All writing</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: var(--space-lg);
    display: grid;
    gap: var(--space-xs);
  }

  .crumbs {
    display: flex;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.72rem;
    margin-bottom: 0.5rem;
  }

  .crumbs a:hover { color: var(--accent); }

  .back { margin-top: var(--space-md); }

  .empty {
    padding: var(--space-lg);
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }
</style>
