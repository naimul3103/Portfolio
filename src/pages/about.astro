---
import SectionHead from '../components/ui/SectionHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAboutPage,
  getAnime,
  getReadingList,
  getSeo,
  getSiteConfig,
  getTimeline,
} from '../lib/config';

const site = getSiteConfig();
const seo = getSeo();
const about = getAboutPage();
const timeline = getTimeline();
const books = getReadingList();
const anime = getAnime();

const title = seo.pages['/about']?.title ?? `About — ${site.name}`;
const description = seo.pages['/about']?.description ?? seo.default.description;
const statusLabels: Record<string, string> = {
  reading: 'Reading',
  finished: 'Finished',
  'want-to-read': 'Want to read',
};
---

<BaseLayout title={title} description={description} type="profile">
  <section class="page-head">
    <div class="shell">
      <p class="eyebrow">{about.eyebrow}</p>
      <h1 class="display reveal">{about.title}</h1>
      <p class="lede">{about.intro}</p>
    </div>
  </section>

  <section class="section story-section">
    <div class="shell story-grid">
      <div class="story">
        {about.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="pull glass">
        <p class="pull-quote">“{about.quote}”</p>
        <div class="pull-meta">
          <span class="mono">{site.location}</span>
          <span class="mono">{site.availability_text}</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead index="01" title="What I optimise for" note="Three rules that survive deadlines" />
      <div class="values">
        {about.values.map((value, i) => (
          <article class="value">
            <span class="value-index mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{value.title}</h3>
            <p>{value.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead index="02" title="The path so far" note="Newest first" />
      <ol class="timeline">
        {timeline.map((entry) => (
          <li class="timeline-item">
            <span class="timeline-year mono">{entry.year}</span>
            <div class="timeline-body">
              <h3>
                {entry.href ? <a class="link" href={entry.href}>{entry.title}</a> : entry.title}
              </h3>
              <p class="timeline-org mono">{entry.org}</p>
              <p class="timeline-desc">{entry.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead index="03" title={about.beyond.title} note={about.beyond.intro} />
      <div class="beyond-grid">
        <article class="beyond-card glass">
          <header>
            <h3>{about.beyond.reading_title}</h3>
            <span class="mono count">{books.filter((b) => b.status === 'reading').length} in progress</span>
          </header>
          <p class="beyond-note">{about.beyond.reading_note}</p>
          <ul class="book-list">
            {books.map((book) => (
              <li class="book">
                <div>
                  <p class="book-title">{book.title}</p>
                  <p class="book-author mono">{book.author}</p>
                </div>
                <span class:list={['badge', `book-${book.status}`]}>{statusLabels[book.status]}</span>
                {book.review && <p class="book-review">{book.review}</p>}
              </li>
            ))}
          </ul>
        </article>

        <div class="beyond-side">
          {anime.length > 0 && (
            <article class="beyond-card glass">
              <header><h3>{about.beyond.anime_title}</h3></header>
              <p class="beyond-note">{about.beyond.anime_note}</p>
              <ul class="book-list">
                {anime.map((item) => (
                  <li class="book">
                    <p class="book-title">{item.title}</p>
                    <span class="badge">{item.status}</span>
                  </li>
                ))}
              </ul>
            </article>
          )}

          <article class="beyond-card glass">
            <header><h3>{about.beyond.gallery_title}</h3></header>
            <p class="beyond-note">{about.beyond.gallery_note}</p>
            <a class="arrow-link" href="/gallery">Open the gallery</a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell closing">
      <div>
        <p class="eyebrow">Next</p>
        <h2>{about.closing.title}</h2>
        <p class="lede">{about.closing.body}</p>
      </div>
      <a class="btn btn-primary" href={about.closing.cta.href}>
        {about.closing.cta.label}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: var(--space-lg);
    display: grid;
    gap: var(--space-sm);
  }

  .page-head h1 {
    max-width: 24ch;
  }

  .page-head .lede {
    max-width: 60ch;
  }

  .story-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  .story {
    display: grid;
    gap: 1.1rem;
    max-width: 62ch;
    font-size: var(--step-0);
    line-height: 1.75;
    color: color-mix(in oklab, var(--text) 90%, var(--muted));
  }

  .pull {
    padding: var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }

  .pull-quote {
    font-size: var(--step-1);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .pull-meta {
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .values {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 1fr;
  }

  .value {
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--surface) 60%, transparent);
    display: grid;
    gap: 0.45rem;
  }

  .value-index {
    color: var(--accent);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .value h3 {
    font-size: var(--step-0);
  }

  .value p {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
    display: grid;
    gap: var(--space-md);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding-left: var(--space-md);
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 14%, transparent);
  }

  .timeline-year {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline-body {
    display: grid;
    gap: 0.25rem;
  }

  .timeline-body h3 {
    font-size: var(--step-0);
  }

  .timeline-org {
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .timeline-desc {
    color: var(--muted);
    font-size: 0.88rem;
    max-width: 62ch;
    line-height: 1.6;
  }

  .beyond-grid {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 1fr;
  }

  .beyond-card {
    padding: var(--space-md);
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .beyond-card header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .beyond-card h3 {
    font-size: var(--step-0);
  }

  .count {
    color: var(--muted);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .beyond-note {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .beyond-side {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .book-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .book {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 0.8rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-top: 1px solid var(--border);
  }

  .book:first-child {
    border-top: 0;
  }

  .book-title {
    font-size: 0.9rem;
    color: var(--text);
  }

  .book-author {
    color: var(--muted);
    font-size: 0.7rem;
  }

  .book-review {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .book-reading {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 35%, transparent);
  }

  .book-finished {
    color: var(--success);
  }

  .closing {
    display: grid;
    gap: var(--space-md);
    align-items: end;
  }

  .closing h2 {
    font-size: var(--step-2);
    margin-top: 0.4rem;
  }

  .closing .lede {
    margin-top: 0.6rem;
  }

  @media (min-width: 760px) {
    .values {
      grid-template-columns: repeat(3, 1fr);
    }
    .timeline-item {
      grid-template-columns: 6rem 1fr;
      gap: var(--space-sm);
    }
    .beyond-grid {
      grid-template-columns: 1.35fr 0.85fr;
    }
    .closing {
      grid-template-columns: 1fr auto;
    }
  }

  @media (min-width: 960px) {
    .story-grid {
      grid-template-columns: 1.5fr 0.85fr;
      gap: var(--space-xl);
    }
    .pull {
      position: sticky;
      top: 6rem;
    }
  }
</style>
