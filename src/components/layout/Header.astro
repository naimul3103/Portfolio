---
import { getNavigation, getSiteConfig } from '../../lib/config';

const site = getSiteConfig();
const entries = getNavigation();
const primary = entries.filter((entry) => entry.primary);
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (url: string) => path === url || (url !== '/' && path.startsWith(`${url}/`));
const initials = site.name
  .split(' ')
  .filter((part) => /^[A-Za-z]/.test(part))
  .slice(-2)
  .map((part) => part[0])
  .join('');
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <span class="monogram" aria-hidden="true">{initials}</span>
      <span class="brand-text">
        <strong>{site.name}</strong>
        <small>{site.role}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {primary.map((entry) => (
        <a href={entry.url} class:list={['nav-link', { active: isActive(entry.url) }]} aria-current={isActive(entry.url) ? 'page' : undefined}>
          {entry.label}
        </a>
      ))}
    </nav>

    <div class="actions">
      <button class="icon-button" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch theme">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
        </svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>

      <a class="btn btn-primary resume-cta" href="/resume">Résumé</a>

      <details class="mobile-menu">
        <summary class="icon-button" aria-label="Open menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="menu-panel glass">
          <p class="menu-label">Navigate</p>
          {entries.map((entry) => (
            <a href={entry.url} aria-current={isActive(entry.url) ? 'page' : undefined}>{entry.label}</a>
          ))}
          <div class="menu-divider" role="presentation"></div>
          <p class="menu-label">Elsewhere</p>
          <a href={site.socials.github} rel="me noopener">GitHub ↗</a>
          <a href={site.socials.linkedin} rel="me noopener">LinkedIn ↗</a>
          <a href={`mailto:${site.email}`}>Email ↗</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-right: auto;
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(140deg, var(--gradient-a), var(--gradient-b));
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-sm);
  }

  /* The light gradient is darker, so near-white monogram text would disappear.
     A solid accent chip keeps the mark legible in both palettes. */
  :global([data-theme='light']) .monogram {
    background: var(--accent);
    color: white;
  }

  .brand-text {
    display: grid;
    line-height: 1.15;
  }

  .brand-text strong {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-text small {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }

  .nav-link {
    position: relative;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.86rem;
    color: var(--muted);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text);
    background: color-mix(in oklab, var(--text) 5%, transparent);
  }

  .nav-link.active {
    color: var(--text);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.2rem;
    height: 1px;
    background: linear-gradient(90deg, var(--gradient-a), var(--gradient-b));
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .icon-button:hover {
    color: var(--text);
    background: color-mix(in oklab, var(--text) 6%, transparent);
    border-color: var(--border);
  }

  /* Icon swap is pure CSS: the button never needs a second render pass. */
  .sun { display: none; }
  :global([data-theme='light']) .sun { display: block; }
  :global([data-theme='light']) .moon { display: none; }

  .resume-cta {
    display: none;
    min-height: 38px;
    padding: 0.45rem 0.85rem;
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    width: min(16rem, calc(100vw - 2rem));
    padding: 0.6rem;
    display: grid;
    gap: 0.1rem;
    box-shadow: var(--shadow-lg);
  }

  .menu-panel a {
    display: block;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--text);
    min-height: 44px;
  }

  .menu-panel a:hover {
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }

  .menu-label {
    padding: 0.5rem 0.7rem 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .menu-divider {
    height: 1px;
    margin: 0.4rem 0.2rem;
    background: var(--border);
  }

  @media (min-width: 900px) {
    .desktop-nav { display: flex; }
    .resume-cta { display: inline-flex; }
    .mobile-menu { display: none; }
  }
</style>
